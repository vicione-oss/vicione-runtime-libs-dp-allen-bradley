<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ViciOne.Suite.DataPort.AllenBradley.Logix</RootNamespace>
    <AssemblyName>ViciOne.Suite.DataPort.AllenBradley.Logix</AssemblyName>
    <Description>DataPort for Allen-Bradley Logix PLCs (ControlLogix, CompactLogix) over CIP/EtherNet-IP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="libplctag" />
    <PackageReference Include="ViciOne.Suite.DataPort" />
    <PackageReference Include="ViciOne.Suite.DataPort.Extensions" />
  </ItemGroup>

  <!-- Configuration file - always copy to output -->
  <ItemGroup>
    <None Update="allen-bradley-logix.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Model\Nodes\DataPoints\Scalars\Integers\" />
  </ItemGroup>

</Project>
