      "versionNonce": 1028,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A failed read degrades its own point. A failed write has no per-value result to ride home on, so it throws, naming every tag it dropped.",
      "rawText": "A failed read degrades its own point. A failed write has no per-value result to ride home on, so it throws, naming every tag it dropped.",
